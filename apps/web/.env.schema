# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Optional PEM CA bundle for local Node.js CLI TLS; keep the path in .env.local.
# Node reads this at process startup, before drizzle.config.ts can load Varlock.
# @optional @type=string(minLength=1)
NODE_EXTRA_CA_CERTS=

# Server-only GroqCloud credential. Never expose through NEXT_PUBLIC_ configuration.
# @type=string(minLength=1)
GROQ_API_KEY=

# CLI only: exact development host/port/user/database independently approved by PM.
# No password or query options; see docs/OWNER_PROVISIONING.md. Not an application signup flag.
# @optional @type=url
SOLYN_OWNER_DEV_TARGET=
